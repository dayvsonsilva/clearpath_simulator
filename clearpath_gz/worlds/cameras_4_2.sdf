<?xml version="1.0"?>
<sdf version="1.6">
    <model name="cameras_4_2">
    <!-- side 1 -->
    <model name="camera1">
      <self_collide>true</self_collide>
      <pose>-15 5.3 4.50 0.0 0.58 0.0</pose> <!-- x, y, z, em metros, roll, pitch, yaw em radianos -->
      <include merge="true">
        <name>camera1</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera1/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera1/image_raw</topic>      
          </sensor>
        </experimental:params>
      </include>
    </model>

    <model name="camera2">
      <self_collide>true</self_collide>

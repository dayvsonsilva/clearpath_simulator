<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="aruco_marker_999">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.002</izz>
        </inertia>
      </inertial>

      <!-- Visual (frente do marcador) -->
      <visual name="front_visual">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 2.0 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://ArUco999/materials/textures/aruco_marker_999.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Visual (verso - branco) -->
      <visual name="back_visual">
        <pose>0 0 -0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 2.0 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Visual (lateral - espessura) -->
      <visual name="edge_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 2.0 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 2.0 0.002</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>

<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.7'>
  <world name='warehouse'>
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-22.986687</latitude_deg>
      <longitude_deg>-43.202501</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <include>
        <uri>
         model://depot/model.sdf
        </uri>
        <name>Depot</name>
        <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Pallet Box Mobile -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile
      </uri>
      <name>pallet_box_0</name>
      <pose>-4 12 0.01 0 0 0</pose>
      <static>true</static>
    </include>


     <!-- Shelves -->

    <include>
        <uri>
         model://shelfs.sdf
        </uri>
        <name>shelfs</name>
        <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- cameras -->
    <include>
      <uri>
      model://Camera/model.sdf
      </uri>
      <name>camera1</name>
      <pose>-15 5.5 4.50 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Camera
      </uri>
      <name>camera2</name>
      <pose>-15 -5.5 4.50 0 0 0</pose>
      <static>true</static>
      <plugin name="gz_ros_camera" filename="libgz_ros_camera.so">
      <ros>
        <namespace>/a200_0000/camera2</namespace>
        <remapping>image_raw:=image_raw</remapping>
      </ros>
      </plugin>
      
    </include>


    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Camera
      </uri>
      <name>camera3</name>
      <pose>-15 0 4.50 0 0 0</pose>
      <static>true</static>
            <plugin name="gz_ros_camera" filename="libgz_ros_camera.so">
        <ros>
          <namespace>/a200_0000/camera3</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
      </plugin>
      
    </include>
 
     <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Camera
      </uri>
      <name>camera4</name>
      <pose>14.9 5.5 4.50 0 0 0</pose>
      <static>true</static>
      <plugin name="gz_ros_camera" filename="libgz_ros_camera.so">
        <ros>
          <namespace>/a200_0000/camera4</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
      </plugin>
      
    </include>

        <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Camera
      </uri>
      <name>camera5</name>
      <pose>14.9 -5.5 4.50 0 0 0</pose>
      <static>true</static>
            <plugin name="gz_ros_camera" filename="libgz_ros_camera.so">
        <ros>
          <namespace>/a200_0000/camera5</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
      </plugin>
      
    </include>

    <!-- <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Camera
      </uri>
      <name>camera6</name>
      <pose>14.9 0 4.50 0 0 0</pose>
      <static>true</static>
            <plugin name="gz_ros_camera" filename="libgz_ros_camera.so">
        <ros>
          <namespace>/a200_0000/camera6</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
      </plugin>
      
    </include> -->

    <model name="camera6">
      <self_collide>true</self_collide>
      <pose>11.75 24.75 7.0 -0.07 0.31 -2.02</pose>

      <include merge="true">
        <name>camera6</name>
        <uri> https://fuel.gazebosim.org/1.0/OpenRobotics/models/Camera</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera6/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera6/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model>

 
    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorOnPhone
      </uri>
      <name>Person 1 - Standing</name>
      <pose>1 -1 0 0 0 1.57</pose>
    </include>

    <include>
      <uri>
      https://fuel.gazebosim.org/1.0/plateau/models/Casual female
      </uri>
      <name>Person 2 - Walking</name>
      <pose>-12 15 0 0 0 0</pose>
    </include>

  </world>
</sdf>

<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.7'>
  <world name='world_demo'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>


    <gui fullscreen="0">

      <!-- 3D scene -->
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>13.4 -6.1 2.23 0 0.4 -1.83</camera_pose>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </ignition-gui>

        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>

      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right" />
            <line own="bottom" target="bottom" />
          </anchors>
        </ignition-gui>

        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="TransformControl" name="Transform control">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="cardBackground" type="string">#666666</property>
        </ignition-gui>
      </plugin>
      <plugin filename="Shapes" name="Shapes">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="cardBackground" type="string">#666666</property>
        </ignition-gui>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property key="x" type="double">400</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="cardBackground" type="string">#666666</property>
        </ignition-gui>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">400</property>
          <property key="height" type="double">375</property>
          <property key="state" type="string">docked_collapsed</property>
        </ignition-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">400</property>
          <property key="height" type="double">375</property>
          <property key="state" type="string">docked_collapsed</property>
        </ignition-gui>
      </plugin>
      <plugin filename="Teleop" name="Teleop">
        <ignition-gui>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">400</property>
          <property key="height" type="double">900</property>
          <property key="state" type="string">docked</property>
        </ignition-gui>
        <topic>/model/tugbot/cmd_vel</topic>
      </plugin>
    </gui>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>-5 -3 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Base -->
    <include>
      <uri>
         model://depot/model.sdf
      </uri>
      <name>warehouse</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- calibrate -->
    <!-- <include>
      <uri>
         model://calibration_plane/calibration_plane.sdf
      </uri>
      <name>calibration_plane</name>
      <pose>0 0 1 0 0 0</pose>
    </include> -->


    <include>
      <uri>
         https://fuel.gazebosim.org/1.0/abmohit/models/Calibration Plane
      </uri>
      <name>checkerboard_plane_2</name>     
      <pose>0 0 3 0 0 0</pose>  
    </include>



     <!-- Shelves -->

    <!-- <include>
        <uri>
         model://shelfs.sdf
        </uri>
        <name>shelfs</name>
        <pose>0 0 0 0 0 0</pose>
    </include> -->

    <!-- Tugbot -->

    <!-- <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot-charging-station
      </uri>
      <name>charging_station</name>
      <pose>14.7 -10.6 -0.04 0 0 0</pose>
    </include> -->

    <!-- <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot
      </uri>
      <name>tugbot</name>
      <pose>13.9 -10.6 0.1 0 0 0</pose>
    </include> -->

    <!-- Cameras -->

    <model name="camera1">
      <self_collide>true</self_collide>
      <pose>-15 5.5 4.50 -0.05 0.58 -0.59</pose>

      <include merge="true">
        <name>camera1</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera1/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera1/image_raw</topic>      
          </sensor>
        </experimental:params>
      </include>
    </model>

    <model name="camera2">
      <self_collide>true</self_collide>
      <pose>-15 0 4.50 0 0.58 0</pose>
        <include merge="true">
        <name>camera2</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera2/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera2/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model>


    <model name="camera3">
      <self_collide>true</self_collide>
      <pose>-15 -5.5 4.50 0.05 0.58 0.59</pose>
      <include merge="true">
        <name>camera3</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera3/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera3/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model>


    <model name="camera4">
      <self_collide>true</self_collide>
      <pose>14.9 5.5 4.50 0.05 0.58 -2.54</pose>
      <include merge="true">
        <name>camera4</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera4/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera4/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model>


    <model name="camera5">
      <self_collide>true</self_collide>
          <pose>14.9 0 4.50 0.0 0.58 3.14159</pose>
      <include merge="true">
        <name>camera5</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera5/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera5/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model>

    <model name="camera6">
      <self_collide>true</self_collide>
      <pose>14.9 -5.5 4.50 -0.05 0.58 2.54</pose>
      <include merge="true">
        <name>camera6</name>
        <uri> model://Camera/model.sdf</uri>
        <experimental:params>
          <sensor element_id="link::camera">
            <camera name="camera" action="modify">
              <camera_info_topic>camera6/camera_info</camera_info_topic>
            </camera>
            <topic action="modify">camera6/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model>

  </world>
</sdf>